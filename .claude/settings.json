{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "WebSearch"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./module-installs/**)"
    ],
    "ask": [],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "sonnet",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\nodejs\\node.exe",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.js"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
